{
  "name": "26b_mtp_throughput_fp8_8192",
  "description": "26B Gemma4 MTP throughput config (FP8, ctx=8192, output=1024).",
  "model": "google/gemma-4-26B-A4B-it-text-only",
  "assistant_model": "google/gemma-4-26B-A4B-it-assistant",
  "served_model_name": "gemma4",
  "tokenizer": "/tmp/models/gemma4/text_only",
  "dataset_path": "../gemma4_moe_fp8/datasets/sc1_delta_v2.jsonl",
  "num_prompts": 1000,
  "max_tokens": 1024,
  "temperature": 0.7,
  "top_p": 0.95,
  "max_model_len": 8192,
  "max_num_seqs": 128,
  "max_num_batched_tokens": 16384,
  "gpu_memory_utilization": 0.90,
  "quantization": "fp8",
  "kv_cache_dtype": "auto",
  "moe_backend": "auto",
  "spec_method": "mtp",
  "speculative_method": "mtp",
  "spec_tokens": 5,
  "draft_model_subdir": "assistant",
  "enforce_eager": false,
  "enable_chunked_prefill": true,
  "enable_prefix_caching": true,
  "optimization_level": 3,
  "performance_mode": "throughput",
  "async_scheduling": true,
  "env": {
    "VLLM_USE_FLASHINFER_MOE_FP8": "0",
    "VLLM_USE_FLASHINFER_SAMPLER": "0",
    "VLLM_MOE_USE_DEEP_GEMM": "0"
  }
}
